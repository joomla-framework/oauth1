{
    "name": "joomla/oauth1",
    "type": "joomla-package",
    "description": "Joomla OAuth1 Package",
    "keywords": ["joomla", "framework", "oauth1"],
    "homepage": "https://github.com/joomla-framework/oauth1",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0",
        "joomla/application": "dev-4.x-dev",
        "joomla/http": "dev-4.x-dev",
        "joomla/input": "dev-4.x-dev",
        "joomla/registry": "dev-4.x-dev",
        "joomla/session": "dev-4.x-dev",
        "joomla/uri": "dev-4.x-dev"
    },
    "require-dev": {
        "joomla/event": "dev-4.x-dev",
        "joomla/test": "dev-4.x-dev",
        "phpunit/phpunit": "^12.2.7",
        "squizlabs/php_codesniffer": "^3.13.2",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-deprecation-rules": "^2.0.3"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\OAuth1\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\OAuth1\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-2.0-dev": "2.0-dev",
            "dev-3.x-dev": "3.0-dev",
            "dev-4.x-dev": "4.0-dev"
        }
    }
}
