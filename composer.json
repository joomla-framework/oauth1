{
    "name": "joomla/oauth1",
    "type": "joomla-package",
    "description": "Joomla OAuth1 Package",
    "keywords": ["joomla", "framework", "oauth1"],
    "homepage": "https://github.com/joomla-framework/oauth1",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0",
        "joomla/application": "^4.0",
        "joomla/http": "^4.0",
        "joomla/input": "^4.0",
        "joomla/registry": "^4.0",
        "joomla/session": "^4.0",
        "joomla/uri": "^4.0"
    },
    "require-dev": {
        "joomla/event": "^4.0",
        "joomla/test": "^4.0",
        "phpunit/phpunit": "^12.2.7",
        "squizlabs/php_codesniffer": "^3.13.2",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-deprecation-rules": "^2.0.3"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\OAuth1\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\OAuth1\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "dev"
}
